rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jaahwix@gmail.com' ||
        request.auth.token.email == 'nabieumelissajosephine@gmail.com' ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'jaahwix@gmail.com' ||
          request.auth.token.email == 'nabieumelissajosephine@gmail.com'
        ))
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
             data.id is string && isValidId(data.id) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'teacher', 'bursar', 'transport', 'student_parent'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && 
                       request.auth.uid == userId && 
                       isValidId(userId) && 
                       incoming().id == userId &&
                       isValidUserProfile(incoming()) &&
                       (incoming().role != 'admin' || isBootstrappedAdmin());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       (
                         isAdmin() ||
                         (
                           request.auth.uid == userId &&
                           incoming().id == existing().id &&
                           incoming().email == existing().email &&
                           incoming().role == existing().role &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
                         )
                       );
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Health / Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }

    // School Operational Collections (Students, Academic, Finances, Staff, Transport, Logistics, Library, Notices)
    match /students/{studentId} {
      allow read, write: if true;
    }

    match /academic_records/{recordId} {
      allow read, write: if true;
    }

    match /fee_ledgers/{ledgerId} {
      allow read, write: if true;
    }

    match /exam_preps/{prepId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /class_notices/{noticeId} {
      allow read, write: if true;
    }

    match /buses/{busId} {
      allow read, write: if true;
    }

    match /bus_assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /daily_attendance/{recordId} {
      allow read, write: if true;
    }

    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    match /library_books/{bookId} {
      allow read, write: if true;
    }

    match /library_checkouts/{checkoutId} {
      allow read, write: if true;
    }

    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    match /reference_snapshots/{snapshotId} {
      allow read, write: if true;
    }
  }
}
